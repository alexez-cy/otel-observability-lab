  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Consumer Records Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_consumer_records_consumed_total[5m]))",
          "legendFormat": "records/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Consumer Lag",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_records_lag)",
          "legendFormat": "lag"
        },
        {
          "refId": "B",
          "expr": "max(kafka_consumer_records_lag_max)",
          "legendFormat": "max lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
